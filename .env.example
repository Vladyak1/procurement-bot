# Шаблон переменных окружения procurement-bot.
#
# Настоящий .env лежит на сервере: /root/procurement-bot/.env (права 600),
# в контейнер попадает через env_file в docker-compose.yml. Локальная копия — в .gitignore.
# Репозиторий публичный: реальные значения секретов сюда не писать никогда.
# Несекретные значения ниже — рабочая конфигурация на 16.09.2026.

# ── Секреты ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather. 16.09.2026 утёк из истории репозитория и был отозван.
BOT_TOKEN=

# Ключ DaData (suggestions API) — координаты объекта по кадастровому номеру.
# Бесплатный лимит 10 000 запросов в сутки. Без ключа геокодер пробует только НСПД.
DADATA_API_KEY=

# Ключи Яндекс Карт (кабинет разработчика) — координаты по адресу там, где не
# помогают ни ЕГРН, ни ФИАС: участки в СНТ на карте есть, а в DaData у них qc_geo=4
# (центр города). Запросы идут только с российского адреса бот-сервера, в обход прокси.
# Без ключей бот просит точку у админа, как делал раньше.
YANDEX_GEOCODER_KEY=
YANDEX_SUGGEST_KEY=

# ── Telegram ───────────────────────────────────────────────────────────────
# ID админ-группы (служебные уведомления, команды, запросы точки на карте)
ADMIN_GROUP_ID=-1234567890
# ID канала публикации лотов
PARSE_GROUP_ID=-1001234567890
# ID администраторов через запятую — только им доступны команды бота
ADMIN_IDS=123456789

# SOCKS5-прокси до Telegram. Сейчас пусто: бот ходит на прямой адрес Telegram
# (extra_hosts в docker-compose.yml).
PROXY_HOST=
PROXY_PORT=

# ── Источники ──────────────────────────────────────────────────────────────
# dynSubjRF=80 — Севастополь во внутренней нумерации torgi (subjectRFCode у лотов = 92)
RSS_URL=https://torgi.gov.ru/new/api/public/lotcards/rss?dynSubjRF=80&lotStatus=PUBLISHED,APPLICATIONS_SUBMISSION&matchPhrase=false&byFirstVersion=true
XHR_URL=https://torgi.gov.ru/new/api/public/lotcards/
DB_URL=data/procurements.db

# ── Фильтры ────────────────────────────────────────────────────────────────
# Слова ищутся ПОДСТРОКОЙ в названии и адресе лота, поэтому основы слов: «помещени»
# ловит «помещение/помещения/помещений». Осторожно с короткими общими словами — они
# режут валидные лоты через адрес («транспорт» ловил «ул. Транспортная»).
# Лот подходит, если есть хотя бы одно слово включения и нет ни одного исключения.
FILTER_INCLUDE_KEYWORDS=нежил,помещени,здани,жил,квартир,земельн,участк,имуществен,комплекс,недвижим,дом,строени,комнат,нестационарных,кадастровый номер
FILTER_EXCLUDE_KEYWORDS=автомобиль,камаз,маз,трактор,погрузчик,лом,судно,гидроцикл,станок,двигатель,фургон,спектометр,автоцистерна,прицеп,военного имущества,отходов,металлов,гидротехническ

# Виды торгов, которые не публикуются вовсе (по полю «Вид торгов»)
FILTER_EXCLUDED_LOT_TYPES=управление многоквартирными домами,отбор региональных операторов,обращение с тко,управляющих организаций
